# /var/lib/rancher/k3s/server/manifests/k3s-server-upgrade-plan.yaml
apiVersion: upgrade.cattle.io/v1
kind: Plan
metadata:
  name: k3s-server-plan
  namespace: system-upgrade
spec:
  concurrency: 1
  cordon: true
  serviceAccountName: system-upgrade

  nodeSelector:
    matchExpressions:
      - key: node-role.kubernetes.io/control-plane
        operator: Exists

  upgrade:
    image: rancher/k3s-upgrade

  version: {{ k3s_upgrade_version }}

  window:
    days:
{% for day in k3s_upgrade_window_days %}
      - {{ day }}
{% endfor %}
    startTime: "{{ k3s_upgrade_window_start_time }}"
    endTime: "{{ k3s_upgrade_window_end_time }}"
    timeZone: "{{ k3s_upgrade_window_timezone }}"
